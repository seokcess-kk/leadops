# ─────────────────────────────────────────────────────────────
# LeadOps 환경변수
# 모든 값은 부팅 시 Zod 로 검증됩니다. 누락 시 즉시 종료합니다(조용한 폴백 없음).
# 실제 키는 .env 에 넣고 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── 데이터 소스 모드 ────────────────────────────────────────
# live : 실제 API 호출. 키가 없으면 부팅 실패
# mock : 고정 목업 데이터. NODE_ENV=production 이면 부팅 실패
FEATURE_SOURCE=mock

# ── ORS (네이버 Open API 기반 콘텐츠 회수 점유율) ──────────
# off    : 어댑터 미로드. ORS 산출 안 함. 배점 0    (기본값)
# shadow : 산출·기록만. 배점 0                       (D-002 이후 기본)
# on     : 배점 25. Phase 4 확증 검증 통과 후에만
# off 가 아닌데 source_registry 승인이 없으면 부팅 실패합니다.
FEATURE_ORS=off

# ── LLM ─────────────────────────────────────────────────────
# off 상태로 전체 파이프라인이 동작해야 합니다 (P5 완료 기준)
FEATURE_LLM=off
ANTHROPIC_API_KEY=
LLM_MONTHLY_CAP_KRW=15000

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────
# 인코딩되지 않은 원본 serviceKey 를 넣으세요
DATA_GO_KR_SERVICE_KEY=

# ── 네이버 검색 오픈 API ────────────────────────────────────
# FEATURE_ORS != off 일 때만 필요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_DAILY_CALL_CAP=20000

# ── YouTube Data API v3 ─────────────────────────────────────
# channels.list(1 unit) 만 사용합니다. search.list(100 unit) 금지
YOUTUBE_API_KEY=

# ── HTTP 클라이언트 ─────────────────────────────────────────
HTTP_USER_AGENT=LeadOpsBot/1.0 (+https://example.kr/bot; contact@example.kr)
HTTP_PER_DOMAIN_INTERVAL_MS=2000
HTTP_GLOBAL_CONCURRENCY=8
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_TOTAL_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2
HTTP_MAX_BODY_BYTES=2097152
HTTP_MAX_REDIRECTS=3

# ── 스파이크 출력 경로 ──────────────────────────────────────
SPIKE_OUT_DIR=./out
